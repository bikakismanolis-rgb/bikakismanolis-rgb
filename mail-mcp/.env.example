# Random secret, at least 24 characters. Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# JSON array of mailboxes, on ONE line. Use app passwords, never your normal password.
MAIL_ACCOUNTS=[{"id":"gmail1","provider":"gmail","email":"you@gmail.com","password":"app-password"},{"id":"yahoo","provider":"yahoo","email":"you@yahoo.com","password":"app-password"}]

# Leave unset to allow drafts only. Set to true to expose the send_email tool.
# MAIL_ALLOW_SEND=true
